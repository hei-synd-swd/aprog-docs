<</Type/Annot/Subtype/Link/Rect[676.6311 9.650391 683.2311 9.650391]/Border[0 0 0]/A<</Type/Action/S/URI/URI(https://play.rust-lang.org/?version=stable&mode=debug&edition=2024&code=%2F%2F%21%20%23%20mycrate%0A%2F%2F%21%0A%2F%2F%21%20Temperature%20conversions%20for%20the%20AProg%20course.%0A%2F%2F%21%20Crate-level%20docs%20%28%60%2F%2F%21%60%29%20sit%20at%20the%20top%20of%20%60lib.rs%60%0A%2F%2F%21%20and%20become%20the%20front%20page%20of%20the%20generated%20site.%0A%2F%2F%21%0A%2F%2F%21%20Playground%20note%3A%20this%20file%20is%20a%20binary%2C%20the%20doc%20examples%20run%20with%20%60cargo%20test%60%20in%20a%20library%20crate.%0A%2F%2F%21%0A%2F%2F%21%20%23%20Examples%0A%2F%2F%21%20%60%60%60%0A%2F%2F%21%20use%20mycrate%3A%3Atemperature%3A%3ACelsius%3B%0A%2F%2F%21%20assert_eq%21%28Celsius%3A%3Anew%280.0%29.to_fahrenheit%28%29%2C%2032.0%29%3B%0A%2F%2F%21%20%60%60%60%0A%0A%2F%2F%2F%20Temperature%20handling.%0Apub%20mod%20temperature%20%7B%0A%20%20%2F%2F%2F%20A%20temperature%20in%20degrees%20Celsius.%0A%20%20%2F%2F%2F%0A%20%20%2F%2F%2F%20%23%20Examples%0A%20%20%2F%2F%2F%20%60%60%60%0A%20%20%2F%2F%2F%20use%20mycrate%3A%3Atemperature%3A%3ACelsius%3B%0A%20%20%2F%2F%2F%20let%20t%20%3D%20Celsius%3A%3Anew%2825.0%29%3B%0A%20%20%2F%2F%2F%20assert_eq%21%28t.to_fahrenheit%28%29%2C%2077.0%29%3B%0A%20%20%2F%2F%2F%20%60%60%60%0A%20%20pub%20struct%20Celsius%28f64%29%3B%0A%0A%20%20impl%20Celsius%20%7B%0A%20%20%20%20%2F%2F%2F%20Creates%20a%20new%20%5B%60Celsius%60%5D%20value.%0A%20%20%20%20pub%20fn%20new%28deg%3A%20f64%29%20-%3E%20Self%20%7B%0A%20%20%20%20%20%20Self%28deg%29%0A%20%20%20%20%7D%0A%0A%20%20%20%20%2F%2F%2F%20Converts%20to%20Fahrenheit.%0A%20%20%20%20%2F%2F%2F%0A%20%20%20%20%2F%2F%2F%20%23%20Panics%0A%20%20%20%20%2F%2F%2F%20Never%20-%20this%20conversion%20is%20total.%0A%20%20%20%20pub%20fn%20to_fahrenheit%28%26self%29%20-%3E%20f64%20%7B%0A%20%20%20%20%20%20self.0%20%2A%209.0%20%2F%205.0%20%2B%2032.0%0A%20%20%20%20%7D%0A%20%20%7D%0A%7D%0A%0Ause%20temperature%3A%3ACelsius%3B%0A%0Afn%20main%28%29%20%7B%0A%20%20%2F%2F%20same%20checks%20as%20the%20doc%20examples%0A%20%20assert_eq%21%28Celsius%3A%3Anew%280.0%29.to_fahrenheit%28%29%2C%2032.0%29%3B%0A%20%20assert_eq%21%28Celsius%3A%3Anew%2825.0%29.to_fahrenheit%28%29%2C%2077.0%29%3B%0A%20%20for%20deg%20in%20%5B0.0%2C%2025.0%2C%20100.0%5D%20%7B%0A%20%20%20%20println%21%28%22%7Bdeg%7D%20%C2%B0C%20%3D%20%7B%7D%20%C2%B0F%22%2C%20Celsius%3A%3Anew%28deg%29.to_fahrenheit%28%29%29%3B%0A%20%20%7D%0A%7D%0A)>>/F 4/StructParent 937/Contents(https://play.rust-lang.org/?version=stable&mode=debug&edition=2024&code=%2F%2F%21%20%23%20mycrate%0A%2F%2F%21%0A%2F%2F%21%20Temperature%20conversions%20for%20the%20AProg%20course.%0A%2F%2F%21%20Crate-level%20docs%20%28%60%2F%2F%21%60%29%20sit%20at%20the%20top%20of%20%60lib.rs%60%0A%2F%2F%21%20and%20become%20the%20front%20page%20of%20the%20generated%20site.%0A%2F%2F%21%0A%2F%2F%21%20Playground%20note%3A%20this%20file%20is%20a%20binary%2C%20the%20doc%20examples%20run%20with%20%60cargo%20test%60%20in%20a%20library%20crate.%0A%2F%2F%21%0A%2F%2F%21%20%23%20Examples%0A%2F%2F%21%20%60%60%60%0A%2F%2F%21%20use%20mycrate%3A%3Atemperature%3A%3ACelsius%3B%0A%2F%2F%21%20assert_eq%21%28Celsius%3A%3Anew%280.0%29.to_fahrenheit%28%29%2C%2032.0%29%3B%0A%2F%2F%21%20%60%60%60%0A%0A%2F%2F%2F%20Temperature%20handling.%0Apub%20mod%20temperature%20%7B%0A%20%20%2F%2F%2F%20A%20temperature%20in%20degrees%20Celsius.%0A%20%20%2F%2F%2F%0A%20%20%2F%2F%2F%20%23%20Examples%0A%20%20%2F%2F%2F%20%60%60%60%0A%20%20%2F%2F%2F%20use%20mycrate%3A%3Atemperature%3A%3ACelsius%3B%0A%20%20%2F%2F%2F%20let%20t%20%3D%20Celsius%3A%3Anew%2825.0%29%3B%0A%20%20%2F%2F%2F%20assert_eq%21%28t.to_fahrenheit%28%29%2C%2077.0%29%3B%0A%20%20%2F%2F%2F%20%60%60%60%0A%20%20pub%20struct%20Celsius%28f64%29%3B%0A%0A%20%20impl%20Celsius%20%7B%0A%20%20%20%20%2F%2F%2F%20Creates%20a%20new%20%5B%60Celsius%60%5D%20value.%0A%20%20%20%20pub%20fn%20new%28deg%3A%20f64%29%20-%3E%20Self%20%7B%0A%20%20%20%20%20%20Self%28deg%29%0A%20%20%20%20%7D%0A%