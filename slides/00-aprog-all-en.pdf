<</Type/Annot/Subtype/Link/Rect[676.6311 9.650391 683.2311 9.650391]/Border[0 0 0]/A<</Type/Action/S/URI/URI(https://play.rust-lang.org/?version=stable&mode=debug&edition=2024&code=%2F%2F%20One%20example%20per%20testing%20tool%3B%20run%20with%20%60cargo%20test%60%20%28Playground%3A%20TEST%29%0A%0Apub%20fn%20add%28a%3A%20i32%2C%20b%3A%20i32%29%20-%3E%20i32%20%7B%0A%20%20a%20%2B%20b%0A%7D%0A%0Apub%20fn%20divide%28a%3A%20i32%2C%20b%3A%20i32%29%20-%3E%20i32%20%7B%0A%20%20if%20b%20%3D%3D%200%20%7B%0A%20%20%20%20panic%21%28%22division%20by%20zero%22%29%3B%0A%20%20%7D%0A%20%20a%20%2F%20b%0A%7D%0A%0A%23%5Bderive%28Debug%29%5D%0Apub%20enum%20GradeError%20%7B%0A%20%20ZeroMax%2C%0A%7D%0A%0Apub%20fn%20check_max%28max%3A%20u32%29%20-%3E%20Result%3Cu32%2C%20GradeError%3E%20%7B%0A%20%20if%20max%20%3D%3D%200%20%7B%20Err%28GradeError%3A%3AZeroMax%29%20%7D%20else%20%7B%20Ok%28max%29%20%7D%0A%7D%0A%0A%23%5Bcfg%28test%29%5D%0Amod%20tests%20%7B%0A%20%20use%20super%3A%3A%2A%3B%0A%0A%20%20%23%5Btest%5D%20%2F%2F%20marks%20a%20test%20function%0A%20%20fn%20assert_true%28%29%20%7B%0A%20%20%20%20assert%21%28add%282%2C%202%29%20%3E%203%29%3B%20%2F%2F%20passes%20if%20the%20condition%20is%20true%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20fn%20assert_equal%28%29%20%7B%0A%20%20%20%20assert_eq%21%28add%282%2C%202%29%2C%204%29%3B%20%2F%2F%20a%20%3D%3D%20b%2C%20both%20values%20shown%20on%20failure%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20fn%20assert_not_equal%28%29%20%7B%0A%20%20%20%20assert_ne%21%28add%282%2C%202%29%2C%205%29%3B%20%2F%2F%20a%20%21%3D%20b%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20fn%20assert_pattern%28%29%20%7B%0A%20%20%20%20assert%21%28matches%21%28check_max%280%29%2C%20Err%28GradeError%3A%3AZeroMax%29%29%29%3B%20%2F%2F%20value%20matches%20a%20pattern%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20fn%20custom_message%28%29%20%7B%0A%20%20%20%20let%20x%20%3D%203%3B%0A%20%20%20%20assert_eq%21%28add%28x%2C%201%29%2C%204%2C%20%22add%28%7Bx%7D%2C%201%29%20is%20wrong%22%29%3B%20%2F%2F%20every%20assert%20takes%20a%20message%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20%23%5Bshould_panic%28expected%20%3D%20%22division%20by%20zero%22%29%5D%20%2F%2F%20passes%20only%20if%20it%20panics%20with%20this%20text%0A%20%20fn%20panics_on_zero%28%29%20%7B%0A%20%20%20%20divide%281%2C%200%29%3B%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20fn%20returns_result%28%29%20-%3E%20Result%3C%28%29%2C%20String%3E%20%7B%0A%20%20%20%20let%20max%20%3D%20check_max%2860%29.map_err%28%7Ce%7C%20format%21%28%22%7Be%3A%3F%7D%22%29%29%3F%3B%20%2F%2F%20%60%3F%60%20inside%20a%20test%2C%20Err%20fails%20it%0A%20%20%20%20assert_eq%21%28max%2C%2060%29%3B%0A%20%20%20%20Ok%28%28%29%29%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20%23%5Bignore%20%3D%20%22slow%22%5D%20%2F%2F%20skipped%2C%20run%20with%20%60cargo%20test%20--%20--ignored%60%0A%20%20fn%20slow_test%28%29%20%7B%0A%20%20%20%20assert_eq%21%28add%281%2C%201%29%2C%202%29%3B%0A%20%20%7D%0A%7D%0A)>>/F 4/StructParent 854/Contents(https://play.rust-lang.org/?version=stable&mode=debug&edition=2024&code=%2F%2F%20One%20example%20per%20testing%20tool%3B%20run%20with%20%60cargo%20test%60%20%28Playground%3A%20TEST%29%0A%0Apub%20fn%20add%28a%3A%20i32%2C%20b%3A%20i32%29%20-%3E%20i32%20%7B%0A%20%20a%20%2B%20b%0A%7D%0A%0Apub%20fn%20divide%28a%3A%20i32%2C%20b%3A%20i32%29%20-%3E%20i32%20%7B%0A%20%20if%20b%20%3D%3D%200%20%7B%0A%20%20%20%20panic%21%28%22division%20by%20zero%22%29%3B%0A%20%20%7D%0A%20%20a%20%2F%20b%0A%7D%0A%0A%23%5Bderive%28Debug%29%5D%0Apub%20enum%20GradeError%20%7B%0A%20%20ZeroMax%2C%0A%7D%0A%0Apub%20fn%20check_max%28max%3A%20u32%29%20-%3E%20Result%3Cu32%2C%20GradeError%3E%20%7B%0A%20%20if%20max%20%3D%3D%200%20%7B%20Err%28GradeError%3A%3AZeroMax%29%20%7D%20else%20%7B%20Ok%28max%29%20%7D%0A%7D%0A%0A%23%5Bcfg%28test%29%5D%0Amod%20tests%20%7B%0A%20%20use%20super%3A%3A%2A%3B%0A%0A%20%20%23%5Btest%5D%20%2F%2F%20marks%20a%20test%20function%0A%20%20fn%20assert_true%28%29%20%7B%0A%20%20%20%20assert%21%28add%282%2C%202%29%20%3E%203%29%3B%20%2F%2F%20passes%20if%20the%20condition%20is%20true%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20fn%20assert_equal%28%29%20%7B%0A%20%20%20%20assert_eq%21%28add%282%2C%202%29%2C%204%29%3B%20%2F%2F%20a%20%3D%3D%20b%2C%20both%20values%20shown%20on%20failure%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20fn%20assert_not_equal%28%29%20%7B%0A%20%20%20%20assert_ne%21%28add%282%2C%202%29%2C%205%29%3B%20%2F%2F%20a%20%21%3D%20b%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20fn%20assert_pattern%28%29%20%7B%0A%20%20%20%20assert%21%28matches%21%28check_max%280%29%2C%20Err%28GradeError%3A%3AZeroMax%29%29%29%3B%20%2F%2F%20value%20matches%20a%20pattern%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20fn%20custom_message%28%29%20%7B%0A%20%20%20%20let%20x%20%3D%203%3B%0A%20%20%20%20assert_eq%21%28add%28x%2C%201%29%2C%204%2C%20%22add%28%7Bx%7D%2C%201%29%20is%20wrong%22%29%3B%20%2F%2F%20every%20assert%20takes%20a%20message%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20%23%5Bshould_panic%28expected%20%3D%20%22division%20by%20zero%22%29%5D%20%2F%2F%20passes%20only%20if%20it%20panics%20with%20this%20text%0A%20%20fn%20panics_on_zero%28%29%20%7B%0A%20%20%20%20divide%281%2C%200%29%3B%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20fn%20returns_result%28%29%20-%3E%20Result%3C%28%29%2C%20String%3E%20%7B%0A%20%20%20%20let%20max%20%3D%20check_max%2860%29.map_err%28%7Ce%7C%20format%21%28%22%7Be%3A%3F%7D%22%29%29%3F%3B%20%2F%2F%20%60%3F%60%20inside%20a%20test%2C%20Err%20fails%20it%0A%20%20%20%20assert_eq%21%28max%2C%2060%29%3B%0A%20%20%20%20Ok%28%28%29%29%0A%20%20%7D%0A%0A%20%20%23%5Btest%5D%0A%20%20%23%5Bignore%20%3D%20%22slow%22%5D%20%2F%2F%20skipped%2C%20run%20with%20%60cargo%20test%20--%20--ignored%60%0A%20%20fn%20slow_test%28%29%20%7B%0A%20%20%20%20assert_eq%21%28add%281%2C%201%29%2C%202%29%3B%0A%20%20%7D%0A%7D%0A)>>
